" Matugen colorscheme — auto-generated by matugen, do not hand-edit
" Colors come from Material You palette derived from your wallpaper.
" Re-run matugen to update after changing wallpaper.

set background=dark
hi clear
if exists("syntax_on")
  syntax reset
endif
let g:colors_name = "matugen"

" ── Terminal ANSI palette (mirrors ghostty/kitty template) ──────────────────
" 0  surface_container_high  (black)
" 1  error                   (red)
" 2  primary                 (green)
" 3  tertiary                (yellow)
" 4  secondary               (blue)
" 5  primary_fixed           (magenta)
" 6  secondary_fixed         (cyan)
" 7  on_surface_variant      (white)
" 8  outline                 (bright black)
" 9  error_container         (bright red)
" 10 primary_container       (bright green)
" 11 tertiary_container      (bright yellow)
" 12 secondary_container     (bright blue)
" 13 inverse_primary         (bright magenta)
" 14 outline_variant         (bright cyan)
" 15 on_surface              (bright white)

let g:terminal_color_0  = "{{ colors.surface_container_high.default.hex }}"
let g:terminal_color_1  = "{{ colors.error.default.hex }}"
let g:terminal_color_2  = "{{ colors.primary.default.hex }}"
let g:terminal_color_3  = "{{ colors.tertiary.default.hex }}"
let g:terminal_color_4  = "{{ colors.secondary.default.hex }}"
let g:terminal_color_5  = "{{ colors.primary_fixed.default.hex }}"
let g:terminal_color_6  = "{{ colors.secondary_fixed.default.hex }}"
let g:terminal_color_7  = "{{ colors.on_surface_variant.default.hex }}"
let g:terminal_color_8  = "{{ colors.outline.default.hex }}"
let g:terminal_color_9  = "{{ colors.error_container.default.hex }}"
let g:terminal_color_10 = "{{ colors.primary_container.default.hex }}"
let g:terminal_color_11 = "{{ colors.tertiary_container.default.hex }}"
let g:terminal_color_12 = "{{ colors.secondary_container.default.hex }}"
let g:terminal_color_13 = "{{ colors.inverse_primary.default.hex }}"
let g:terminal_color_14 = "{{ colors.outline_variant.default.hex }}"
let g:terminal_color_15 = "{{ colors.on_surface.default.hex }}"

" ── Base UI ─────────────────────────────────────────────────────────────────
hi Normal        guibg=NONE guifg={{ colors.on_surface.dark.hex }}
hi NormalNC      guibg=NONE guifg={{ colors.on_surface_variant.dark.hex }}
hi NormalFloat   guibg=NONE guifg={{ colors.on_surface.dark.hex }}
hi FloatBorder   guibg=NONE guifg={{ colors.outline.dark.hex }}
hi FloatTitle    guibg=NONE guifg={{ colors.primary.dark.hex }} gui=bold
hi SignColumn    guibg=NONE guifg={{ colors.outline.dark.hex }}
hi EndOfBuffer   guibg=NONE guifg={{ colors.surface_variant.dark.hex }}
hi VertSplit     guibg=NONE guifg={{ colors.outline_variant.dark.hex }}
hi WinSeparator  guibg=NONE guifg={{ colors.outline_variant.dark.hex }}

" ── Status & Tab lines ──────────────────────────────────────────────────────
hi StatusLine    guibg={{ colors.primary.dark.hex }} guifg={{ colors.on_primary.dark.hex }}
hi StatusLineNC  guibg={{ colors.primary_container.dark.hex }} guifg={{ colors.on_primary_container.dark.hex }}
hi TabLine       guibg=NONE guifg={{ colors.on_surface_variant.dark.hex }}
hi TabLineFill   guibg=NONE guifg={{ colors.outline.dark.hex }}
hi TabLineSel    guibg={{ colors.primary_container.dark.hex }} guifg={{ colors.on_primary_container.dark.hex }} gui=bold

" ── Line numbers & cursor ────────────────────────────────────────────────────
hi LineNr        guibg=NONE guifg={{ colors.outline.dark.hex }}
hi CursorLineNr  guibg=NONE guifg={{ colors.primary.dark.hex }} gui=bold
hi CursorLine    guibg={{ colors.surface_container_high.dark.hex }} guifg=NONE
hi CursorColumn  guibg={{ colors.surface_container_high.dark.hex }} guifg=NONE
hi ColorColumn   guibg={{ colors.surface_container_highest.dark.hex }} guifg=NONE
hi Cursor        guibg={{ colors.primary.dark.hex }} guifg={{ colors.on_primary.dark.hex }}
hi lCursor       guibg={{ colors.secondary.dark.hex }} guifg={{ colors.on_secondary.dark.hex }}

" ── Folds ───────────────────────────────────────────────────────────────────
hi FoldColumn    guibg=NONE guifg={{ colors.outline.dark.hex }}
hi Folded        guibg=NONE guifg={{ colors.outline_variant.dark.hex }} gui=italic

" ── Search & Selection ──────────────────────────────────────────────────────
hi Search        guibg={{ colors.tertiary_container.dark.hex }} guifg={{ colors.on_tertiary_container.dark.hex }}
hi IncSearch     guibg={{ colors.tertiary.dark.hex }} guifg={{ colors.on_tertiary.dark.hex }}
hi CurSearch     guibg={{ colors.tertiary.dark.hex }} guifg={{ colors.on_tertiary.dark.hex }}
hi Visual        guibg={{ colors.secondary_container.dark.hex }} guifg={{ colors.on_secondary_container.dark.hex }}
hi VisualNOS     guibg={{ colors.secondary_container.dark.hex }} guifg={{ colors.on_secondary_container.dark.hex }}
hi Substitute    guibg={{ colors.error_container.dark.hex }} guifg={{ colors.on_error_container.dark.hex }}

" ── Popup menu ──────────────────────────────────────────────────────────────
hi Pmenu         guibg={{ colors.surface_container.dark.hex }} guifg={{ colors.on_surface.dark.hex }}
hi PmenuSel      guibg={{ colors.primary_container.dark.hex }} guifg={{ colors.on_primary_container.dark.hex }} gui=bold
hi PmenuSbar     guibg={{ colors.surface_container_high.dark.hex }} guifg=NONE
hi PmenuThumb    guibg={{ colors.outline.dark.hex }} guifg=NONE
hi PmenuBorder   guibg=NONE guifg={{ colors.outline.dark.hex }}
hi PmenuKind     guibg={{ colors.surface_container.dark.hex }} guifg={{ colors.secondary.dark.hex }}
hi PmenuKindSel  guibg={{ colors.primary_container.dark.hex }} guifg={{ colors.secondary.dark.hex }}
hi PmenuExtra    guibg={{ colors.surface_container.dark.hex }} guifg={{ colors.on_surface_variant.dark.hex }}
hi PmenuExtraSel guibg={{ colors.primary_container.dark.hex }} guifg={{ colors.on_surface_variant.dark.hex }}

" ── Messages & errors ────────────────────────────────────────────────────────
hi Error         guibg={{ colors.error_container.dark.hex }} guifg={{ colors.on_error_container.dark.hex }}
hi ErrorMsg      guibg={{ colors.error_container.dark.hex }} guifg={{ colors.on_error_container.dark.hex }}
hi WarningMsg    guibg=NONE guifg={{ colors.tertiary.dark.hex }}
