" ── Diffs ───────────────────────────────────────────────────────────────────
hi DiffAdd       guibg={{ colors.tertiary_container.dark.hex }} guifg=NONE
hi DiffChange    guibg={{ colors.secondary_container.dark.hex }} guifg=NONE
hi DiffDelete    guibg={{ colors.error_container.dark.hex }} guifg={{ colors.on_error_container.dark.hex }}
hi DiffText      guibg={{ colors.tertiary.dark.hex }} guifg={{ colors.on_tertiary.dark.hex }}

" ── Spelling ────────────────────────────────────────────────────────────────
hi SpellBad      guibg=NONE guifg={{ colors.error.dark.hex }} gui=undercurl guisp={{ colors.error.dark.hex }}
hi SpellCap      guibg=NONE guifg={{ colors.tertiary.dark.hex }} gui=undercurl guisp={{ colors.tertiary.dark.hex }}
hi SpellRare     guibg=NONE guifg={{ colors.secondary.dark.hex }} gui=undercurl guisp={{ colors.secondary.dark.hex }}
hi SpellLocal    guibg=NONE guifg={{ colors.primary.dark.hex }} gui=undercurl guisp={{ colors.primary.dark.hex }}

