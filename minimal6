    def on():
        run(["dunstctl", "set-paused", "true"])
    def off():
        run(["dunstctl", "set-paused", "false"])
    toggle_ui(primary, "DND", status, on, off)


def toggle_caffeine(primary):
    def status(): return pgrep_running("hypridle")
    def on():
        run(["hyprctl", "dispatch", "exec", f"hypridle -c {os.path.join(HYPR_DIR, 'hypridle.conf')}"])
    def off():
        run(["pkill", "-9", "-x", "hypridle"])
        run(["killall", "-9", "hypridle"])
    toggle_ui(primary, "Caffeine", status, on, off)


def toggle_gamemode(primary):
    def status(): return not hyprctl_bool("animations:enabled")
    def on():
        run(["hyprctl", "keyword", "animations:enabled", "false"])
        run(["hyprctl", "keyword", "decoration:blur:enabled", "false"])
        run(["hyprctl", "keyword", "decoration:shadow:enabled", "false"])
    def off():
        run(["hyprctl", "reload"])
    toggle_ui(primary, "Gamemode", status, on, off)


