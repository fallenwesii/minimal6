def wifi_connect(primary):
    notify("Scanning for WiFi networks...")
    run(["nmcli", "device", "wifi", "rescan"])
    out = run_out(["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "device", "wifi", "list"])
    nets = []
    seen = set()
    for line in out.splitlines():
        parts = line.split(":")
        if len(parts) >= 1 and parts[0] and parts[0] not in seen:
            seen.add(parts[0])
            nets.append((parts[0], parts[1] if len(parts) > 1 else "?", parts[2] if len(parts) > 2 else ""))
    if not nets:
        notify("No WiFi networks found")
        return
    sel = 0
    dim_p = dim_color(primary, 0.4)
    while True:
        clear()
        banner(primary)
        print(f"\n{c_fg(primary)}{BOLD}Available Networks{RST}\n")
        for i, (ssid, sig, sec) in enumerate(nets):
            label = f"{ssid[:28]:28} {sig:>3}%  {sec}"
            if i == sel:
                print(f"{c_fg(primary)}{BOLD}  → {i+1}. {label}{RST}")
            else:
                print(f"{c_fg(dim_p)}    {i+1}. {label}{RST}")
        print(f"\n  {c_fg(dim_p)}ESC: Back  ENTER: Connect  ↑↓: Navigate{RST}")
        key = get_key()
        if key == 'UP':
            sel = (sel - 1) % len(nets)
        elif key == 'DOWN':
            sel = (sel + 1) % len(nets)
        elif key == 'ENTER':
            ssid, sig, sec = nets[sel]
            if sec and sec != "--":
                pw = read_line(f"{c_fg(primary)}Password for {ssid}: {RST}")
                run(["nmcli", "device", "wifi", "connect", ssid, "password", pw])
            else:
                run(["nmcli", "device", "wifi", "connect", ssid])
            notify(f"Connecting to {ssid}...")
            return
        elif key == 'ESC':
            return


