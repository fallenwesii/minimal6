def bt_connect(primary):
    notify("Scanning for Bluetooth devices...")
    run(["bluetoothctl", "--timeout", "5", "scan", "on"])
    out = run_out(["bluetoothctl", "devices"])
    devs = []
    for line in out.splitlines():
        m = re.match(r'Device\s+([0-9A-F:]+)\s+(.+)', line, re.I)
        if m:
            devs.append((m.group(1), m.group(2)))
    if not devs:
        notify("No Bluetooth devices found")
        return
    sel = 0
    dim_p = dim_color(primary, 0.4)
    while True:
        clear()
        banner(primary)
        print(f"\n{c_fg(primary)}{BOLD}Devices{RST}\n")
        for i, (mac, name) in enumerate(devs):
            label = f"{name} ({mac})"
            if i == sel:
                print(f"{c_fg(primary)}{BOLD}  → {i+1}. {label}{RST}")
            else:
                print(f"{c_fg(dim_p)}    {i+1}. {label}{RST}")
        print(f"\n  {c_fg(dim_p)}ESC: Back  ENTER: Connect  ↑↓: Navigate{RST}")
        key = get_key()
        if key == 'UP':
            sel = (sel - 1) % len(devs)
        elif key == 'DOWN':
            sel = (sel + 1) % len(devs)
        elif key == 'ENTER':
            mac, name = devs[sel]
            notify(f"Pairing & connecting to {name}...")
            run(["bluetoothctl", "pair", mac])
            run(["bluetoothctl", "trust", mac])
            run(["bluetoothctl", "connect", mac])
            notify(f"Connected to {name}")
            return
        elif key == 'ESC':
            return


