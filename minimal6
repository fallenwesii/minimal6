#!/usr/bin/env python3
import os, sys, re, subprocess, tty, termios, select

HOME = os.path.expanduser("~")
HYPR_DIR = os.path.join(HOME, ".config", "hypr")
CONF_DIR = os.path.join(HYPR_DIR, "conf")
COLORS_FILE = os.path.join(HYPR_DIR, "colors.conf")
APPEARANCE_CONF = os.path.join(CONF_DIR, "appearance.conf")
STARTUP_CONF = os.path.join(CONF_DIR, "startup.conf")
MONITORS_CONF = os.path.join(CONF_DIR, "monitors.conf")
PROGRAMS_CONF = os.path.join(CONF_DIR, "programs.conf")
WALLPAPERS_DIR = os.path.join(HOME, "Pictures", "wallpapers")
MINIMAL6_DIR = os.path.join(HOME, "minimal6")

RST = "\033[0m"
BOLD = "\033[1m"
CLR = "\033[2J\033[H"


def get_primary_color():
    if not os.path.exists(COLORS_FILE):
        return "ffb4ac"
    with open(COLORS_FILE) as f:
        for line in f:
            m = re.search(r'\$primary\s*=\s*rgba?\(([0-9a-fA-F]{6,8})', line)
            if m:
                return m.group(1)[:6].lower()
    return "ffb4ac"


def hex_to_rgb(h):
    h = h.lstrip('#')
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def rgb_to_hex(r, g, b):
    return f"{r:02x}{g:02x}{b:02x}"


def dim_color(h, f=0.4):
    r, g, b = hex_to_rgb(h)
    return rgb_to_hex(int(r * f), int(g * f), int(b * f))


def c_fg(h):
    r, g, b = hex_to_rgb(h)
    return f"\033[38;2;{r};{g};{b}m"


def readf(path):
    if not os.path.exists(path):
        return ""
    with open(path) as f:
        return f.read()


def writef(path, content):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w') as f:
        f.write(content)


def notify(msg):
    subprocess.run(["dunstify", msg],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def run(cmd):
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def run_out(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True).stdout.strip()
    except Exception:
        return ""


def get_default_terminal():
    content = readf(PROGRAMS_CONF)
    m = re.search(r'^\$terminal\s*=\s*(.+)', content, re.M)
    if m:
        t = m.group(1).strip()
        t_bin = t.split()[0]
        return t_bin
    return "ghostty"


def clear():
    print(CLR, end="")


# ── Terminal Key Handling ──

def get_key():
    if not sys.stdin.isatty():
        ch = sys.stdin.read(1)
        if not ch or ch == '\x1b' or ch == 'q': return 'ESC'
        if ch in ('\n', '\r'): return 'ENTER'
        return ch
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        b = os.read(fd, 1)
        if not b:
            return 'ESC'
        if b == b'\x1b':
            r, _, _ = select.select([fd], [], [], 0.05)
            if r:
                b2 = os.read(fd, 1)
                if b2 in (b'[', b'O'):
                    r2, _, _ = select.select([fd], [], [], 0.05)
                    if r2:
                        b3 = os.read(fd, 1)
                        if b3 == b'A': return 'UP'
                        if b3 == b'B': return 'DOWN'
                        if b3 == b'C': return 'RIGHT'
                        if b3 == b'D': return 'LEFT'
            return 'ESC'
        if b in (b'\r', b'\n'): return 'ENTER'
        if b == b'\x03': raise KeyboardInterrupt
        if b in (b'\x7f', b'\x08'): return 'BACK'
        return b.decode('utf-8', errors='ignore')
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def read_line(prompt=""):
    if sys.stdin.isatty():
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    try:
        return input(prompt).strip()
    finally:
        pass


# ── Banner ──

def banner(primary):
    try:
        import pyfiglet
        fig = pyfiglet.figlet_format("minimal6", font="slant")
    except ImportError:
        fig = "\n  minimal6\n"
    for line in fig.splitlines():
        if line.strip():
            print(f"{c_fg(primary)}{line}{RST}")
        else:
            print()


# ── Appearance helpers ──

APPEARANCE_KEYS = {
    "rounding":     ("decoration:rounding",    r'(rounding\s*=\s*)\d+'),
    "gaps_in":      ("general:gaps_in",        r'(gaps_in\s*=\s*)\d+'),
    "gaps_out":     ("general:gaps_out",       r'(gaps_out\s*=\s*)\d+'),
    "border_size":  ("general:border_size",    r'(border_size\s*=\s*)\d+'),
}


def update_appearance(cfg_key, value):
    if cfg_key not in APPEARANCE_KEYS:
        return False
    hkey, pattern = APPEARANCE_KEYS[cfg_key]
    content = readf(APPEARANCE_CONF)
    if re.search(pattern, content):
        content = re.sub(pattern, rf'\g<1>{value}', content)
    else:
        content += f"\n{cfg_key} = {value}\n"
    writef(APPEARANCE_CONF, content)
    run(["hyprctl", "keyword", hkey, str(value)])
    return True


def update_startup_wallpaper(path):
    content = readf(STARTUP_CONF)
    if re.search(r'exec-once\s*=\s*awww\s+img', content):
        new = re.sub(
            r'exec-once\s*=\s*awww\s+img\s+.*',
            f'exec-once = awww img "{path}" --transition-type none',
            content,
        )
    else:
        new = content.rstrip() + f'\nexec-once = awww img "{path}" --transition-type none\n'
    writef(STARTUP_CONF, new)


def hyprctl_bool(opt):
    out = run_out(["hyprctl", "getoption", opt])
    m = re.search(r'(?:int|bool):\s*(\d)', out)
    return m is not None and m.group(1) == "1"


def pgrep_running(name):
    return run_out(["pgrep", "-x", name]) != ""


# ── Menu Renderer ──

def show_menu(title, items, primary, back=True, default_sel=0):
    sel = default_sel
    dim_p = dim_color(primary, 0.4)
    while True:
        clear()
        banner(primary)
        print(f"\n{c_fg(primary)}{BOLD}{title}{RST}")
        print(f"{c_fg(dim_p)}{'─' * 40}{RST}")
        for i, item in enumerate(items):
            if i == sel:
                print(f"{c_fg(primary)}{BOLD}  → {item}{RST}")
            else:
                print(f"{c_fg(dim_p)}    {item}{RST}")
        print()
        if back:
            print(f"  {c_fg(dim_p)}ESC: Back  ENTER: Select  1-{len(items)}: Select  ↑↓: Navigate{RST}")
        else:
            print(f"  {c_fg(dim_p)}ESC: Quit  ENTER: Select  1-{len(items)}: Select  ↑↓: Navigate{RST}")

        key = get_key()
        if key == 'UP':
            sel = (sel - 1) % len(items)
        elif key == 'DOWN':
            sel = (sel + 1) % len(items)
        elif key == 'ENTER':
            return str(sel + 1)
        elif key == 'ESC':
            return '0'
        elif key.isdigit() and 1 <= int(key) <= len(items):
            return key


# ── Wallpaper ──

def wallpaper_ui(primary):
    if not os.path.exists(WALLPAPERS_DIR):
        notify("Wallpapers directory not found")
        return primary
    wps = sorted(f for f in os.listdir(WALLPAPERS_DIR)
                 if f.lower().endswith((".jpg", ".jpeg", ".png", ".webp", ".gif")))
    if not wps:
        notify("No wallpapers found in ~/Pictures/wallpapers")
        return primary

    sel = 0
    view_size = 10

    while True:
        dim_p = dim_color(primary, 0.4)
        clear()
        banner(primary)
        print(f"\n{c_fg(primary)}{BOLD}Wallpapers (Total: {len(wps)}){RST}\n")

        if len(wps) <= view_size:
            view_start = 0
        else:
            view_start = max(0, min(sel - view_size // 2, len(wps) - view_size))
        view_end = min(len(wps), view_start + view_size)

        for i in range(view_start, view_end):
            wp = wps[i]
            idx_str = f"{i+1}."
            if i == sel:
                print(f"{c_fg(primary)}{BOLD}  → {idx_str:>3} {wp[:44]}{RST}")
            else:
                print(f"{c_fg(dim_p)}    {idx_str:>3} {wp[:44]}{RST}")

        print(f"\n  {c_fg(dim_p)}ESC: Back  ENTER: Select  ↑↓: Navigate{RST}")
        key = get_key()
        if key == 'UP':
            sel = (sel - 1) % len(wps)
        elif key == 'DOWN':
            sel = (sel + 1) % len(wps)
        elif key == 'ENTER':
            full_path = os.path.abspath(os.path.join(WALLPAPERS_DIR, wps[sel]))
            notify("Generating colors with Matugen...")
            run(["matugen", "-m", "dark", "image", full_path, "--source-color-index", "0"])
            update_startup_wallpaper(full_path)
            run(["awww", "img", full_path, "--transition-type", "none"])
            run(["hyprctl", "reload"])
            primary = get_primary_color()
            notify(f"Wallpaper updated: {wps[sel]}")
            return primary
        elif key == 'ESC':
            return primary


# ── Value Picker ──

def simple_picker(primary, title, cfg_key, lo, hi):
    vals = list(range(lo, hi + 1))
    sel = 0
    dim_p = dim_color(primary, 0.4)
    while True:
        clear()
        banner(primary)
        print(f"\n{c_fg(primary)}{BOLD}{title}{RST}\n")
        for i, v in enumerate(vals):
            if i == sel:
                print(f"{c_fg(primary)}{BOLD}  → {v}{RST}")
            else:
                print(f"{c_fg(dim_p)}    {v}{RST}")
        print(f"\n  {c_fg(dim_p)}ESC: Back  ENTER: Select  ↑↓: Navigate{RST}")
        key = get_key()
        if key == 'UP':
            sel = (sel - 1) % len(vals)
        elif key == 'DOWN':
            sel = (sel + 1) % len(vals)
        elif key == 'ENTER':
            update_appearance(cfg_key, str(vals[sel]))
            notify(f"{title} set to {vals[sel]}")
            return
        elif key == 'ESC':
            return
        elif key.isdigit() and lo <= int(key) <= hi:
            update_appearance(cfg_key, key)
            notify(f"{title} set to {key}")
            return


# ── Toggle UI ──

def toggle_ui(primary, name, get_status, set_on, set_off):
    first = True
    dim_p = dim_color(primary, 0.4)
    while True:
        st = get_status()
        if first:
            sel = 0 if not st else 1
            first = False
        items = ["1.Toggle On", "2.Toggle Off"]
        clear()
        banner(primary)
        print(f"\n{c_fg(primary)}{BOLD}{name}{RST}")
        status_str = "on" if st else "off"
        print(f"{c_fg(dim_p)}status: {status_str}{RST}\n")
        for i, item in enumerate(items):
            if i == sel:
                print(f"{c_fg(primary)}{BOLD}  → {item}{RST}")
            else:
                print(f"{c_fg(dim_p)}    {item}{RST}")
        print(f"\n  {c_fg(dim_p)}ESC: Back  ENTER: Select  1-2: Select  ↑↓: Navigate{RST}")
        key = get_key()
        if key == 'UP':
            sel = (sel - 1) % 2
        elif key == 'DOWN':
            sel = (sel + 1) % 2
        elif key == 'ENTER':
            if sel == 0:
                set_on()
                notify(f"{name} turned ON")
                first = True
            elif sel == 1:
                set_off()
                notify(f"{name} turned OFF")
                first = True
        elif key == '1':
            set_on()
            notify(f"{name} turned ON")
            first = True
        elif key == '2':
            set_off()
            notify(f"{name} turned OFF")
            first = True
        elif key == 'ESC':
            return


# ── Toggle implementations ──

def toggle_animations(primary):
    def status(): return hyprctl_bool("animations:enabled")
    def on():
        run(["hyprctl", "keyword", "animations:enabled", "true"])
        content = readf(APPEARANCE_CONF)
        if re.search(r'animations\s*\{', content):
            content = re.sub(
                r'(animations\s*\{[^}]*?enabled\s*=\s*)\w+',
                r'\g<1>true', content, flags=re.DOTALL)
        else:
            content += "\nanimations {\n  enabled = true\n}\n"
        writef(APPEARANCE_CONF, content)
    def off():
        run(["hyprctl", "keyword", "animations:enabled", "false"])
        content = readf(APPEARANCE_CONF)
        if re.search(r'animations\s*\{', content):
            content = re.sub(
                r'(animations\s*\{[^}]*?enabled\s*=\s*)\w+',
                r'\g<1>false', content, flags=re.DOTALL)
        else:
            content += "\nanimations {\n  enabled = false\n}\n"
        writef(APPEARANCE_CONF, content)
    toggle_ui(primary, "Animations", status, on, off)


