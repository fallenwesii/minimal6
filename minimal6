        content = readf(PROGRAMS_CONF)
        clear()
        banner(primary)
        print(f"\n{c_fg(primary)}{BOLD}Default Apps{RST}\n")
        current = {}
        for var, label in APPS_FIELDS:
            m = re.search(rf'^{re.escape(var)}\s*=\s*(.+)', content, re.M)
            val = m.group(1).strip() if m else ""
            current[var] = val
        for i, (var, label) in enumerate(APPS_FIELDS):
            item_str = f"{i+1}. {label}: {current[var]}"
            if i == sel:
                print(f"{c_fg(primary)}{BOLD}  → {item_str}{RST}")
            else:
                print(f"{c_fg(dim_p)}    {item_str}{RST}")
        print(f"\n  {c_fg(dim_p)}ESC: Back  ENTER: Edit  1-3: Select  ↑↓: Navigate{RST}")
        key = get_key()
        if key == 'UP':
            sel = (sel - 1) % len(APPS_FIELDS)
        elif key == 'DOWN':
            sel = (sel + 1) % len(APPS_FIELDS)
        elif key == 'ENTER':
            var, label = APPS_FIELDS[sel]
            old = current[var]
            new = read_line(f"{c_fg(primary)}Enter new {label} [{old}]: {RST}")
            if new:
                if re.search(rf'^{re.escape(var)}\s*=', content, re.M):
                    content = re.sub(
                        rf'^{re.escape(var)}\s*=\s*.*$',
                        f"{var} = {new}",
                        content,
                        flags=re.M,
                    )
                else:
                    content += f"\n{var} = {new}\n"
                writef(PROGRAMS_CONF, content)
                notify(f"{label} updated to {new}")
        elif key in ('1', '2', '3'):
            sel = int(key) - 1
            var, label = APPS_FIELDS[sel]
            old = current[var]
            new = read_line(f"{c_fg(primary)}Enter new {label} [{old}]: {RST}")
            if new:
                if re.search(rf'^{re.escape(var)}\s*=', content, re.M):
                    content = re.sub(
                        rf'^{re.escape(var)}\s*=\s*.*$',
                        f"{var} = {new}",
                        content,
                        flags=re.M,
                    )
                else:
                    content += f"\n{var} = {new}\n"
                writef(PROGRAMS_CONF, content)
                notify(f"{label} updated to {new}")
        elif key == 'ESC':
            return


# ── Monitor ──

def monitor_menu(primary):
    dim_p = dim_color(primary, 0.4)
    content = readf(MONITORS_CONF)
    
    mon_name = "eDP-1"
    highest_res_hz = "1366x768@60.00Hz"
    max_hz = "60.00Hz"

    out = run_out(["hyprctl", "monitors", "-j"])
    try:
        import json
        mons = json.loads(out)
        if mons and isinstance(mons, list):
            m0 = mons[0]
            mon_name = m0.get("name", "eDP-1")
            modes = m0.get("availableModes", [])
            if modes:
                highest_res_hz = modes[0]
                hz_m = re.search(r'@([\d\.]+)Hz', highest_res_hz, re.I)
                if hz_m:
                    max_hz = hz_m.group(1) + "Hz"
    except Exception:
        pass

    m_conf = re.search(r'monitor\s*=\s*([^,\s]+),([^,\s]+)', content)
    current_res = m_conf.group(2) if m_conf else highest_res_hz
    if m_conf:
        mon_name = m_conf.group(1)

    opts = [
        highest_res_hz,
        f"1920x1080@{max_hz}",
        f"3840x2160@{max_hz}",
    ]
    sel = 0

    while True:
        clear()
        banner(primary)
        print(f"\n{c_fg(primary)}{BOLD}Select Screen Resolution{RST}\n")
        for i, opt in enumerate(opts):
            mark = " (current)" if opt == current_res else ""
            item_str = f"{i+1}. {opt}{mark}"
            if i == sel:
                print(f"{c_fg(primary)}{BOLD}  → {item_str}{RST}")
            else:
                print(f"{c_fg(dim_p)}    {item_str}{RST}")
        print(f"\n  {c_fg(dim_p)}ESC: Back  ENTER: Apply  1-3: Select  ↑↓: Navigate{RST}")
        key = get_key()
        if key == 'UP':
            sel = (sel - 1) % len(opts)
        elif key == 'DOWN':
            sel = (sel + 1) % len(opts)
        elif key == 'ENTER':
            res = opts[sel]
            if re.search(r'monitor\s*=', content):
                content = re.sub(
                    r'(monitor\s*=\s*[^,\s]+,)[^,\s]+',
                    rf'\g<1>{res}',
                    content,
                )
            else:
                content += f"\nmonitor={mon_name},{res},auto,1\n"
            writef(MONITORS_CONF, content)
            run(["hyprctl", "keyword", "monitor", f"{mon_name},{res},auto,1"])
            notify(f"Resolution set to {res}")
            return
        elif key in ('1', '2', '3'):
            sel = int(key) - 1
            res = opts[sel]
            if re.search(r'monitor\s*=', content):
                content = re.sub(
                    r'(monitor\s*=\s*[^,\s]+,)[^,\s]+',
                    rf'\g<1>{res}',
                    content,
                )
            else:
                content += f"\nmonitor={mon_name},{res},auto,1\n"
            writef(MONITORS_CONF, content)
            run(["hyprctl", "keyword", "monitor", f"{mon_name},{res},auto,1"])
            notify(f"Resolution set to {res}")
            return
        elif key == 'ESC':
            return


# ── Update ──

def check_update(primary):
    clear()
    banner(primary)
    dim_p = dim_color(primary, 0.4)
    print(f"\n{c_fg(primary)}{BOLD}Update{RST}")
    print(f"{c_fg(dim_p)}Note: This is not a system update (updates minimal6 dotfiles only).\n{RST}")
    
    if not os.path.exists(os.path.join(MINIMAL6_DIR, ".git")):
        print(f"{c_fg(primary)}Git repository not found at {MINIMAL6_DIR}{RST}")
        read_line(f"\n{c_fg(dim_p)}Press Enter to return…{RST}")
        return

    notify("Checking for dotfiles updates...")
    run_out(["git", "-C", MINIMAL6_DIR, "fetch", "origin"])
    
    branch = run_out(["git", "-C", MINIMAL6_DIR, "rev-parse", "--abbrev-ref", "HEAD"]) or "dev"
    ahead = run_out(["git", "-C", MINIMAL6_DIR, "rev-list", "--count", f"HEAD..origin/{branch}"])
    
    if ahead and ahead.isdigit() and int(ahead) > 0:
        log = run_out(["git", "-C", MINIMAL6_DIR, "log", f"HEAD..origin/{branch}", "--oneline"])
        print(f"{c_fg(primary)}{ahead} update(s) available from origin/{branch}:\n{RST}")
        for line in log.splitlines():
            print(f"{c_fg(dim_p)}  - {line}{RST}")
        print()
        ans = read_line(f"{c_fg(primary)}Pull updates and update symlinks? (y/N): {RST}").lower()
        if ans == 'y':
            run_out(["git", "-C", MINIMAL6_DIR, "pull", "origin", branch])
            setup_script = os.path.join(MINIMAL6_DIR, "setup.sh")
            if os.path.exists(setup_script):
                run(["bash", setup_script])
            notify("minimal6 dotfiles updated & symlinks refreshed!")
            print(f"\n{c_fg(primary)}Successfully updated!{RST}")
        else:
            notify("Update skipped")
    else:
        print(f"{c_fg(primary)}minimal6 dotfiles are already up to date.{RST}")
        notify("minimal6 is up to date")
    
    read_line(f"\n{c_fg(dim_p)}Press Enter to return…{RST}")


